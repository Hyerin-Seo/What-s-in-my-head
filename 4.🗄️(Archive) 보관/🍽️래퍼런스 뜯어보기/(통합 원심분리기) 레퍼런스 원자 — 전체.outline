              "isFolded": false,
              "createdAt": 1793170364660,
              "updatedAt": 1793170364660
            }
          ],
          "isFolded": false,
          "createdAt": 1793170364660,
          "updatedAt": 1793170364660
        },
        {
          "id": "FaNwzJPacubB",
          "text": "저장 버튼 없음 — 저절로 저장되고 모든 기기에 동기화된다. 저장 버튼이 없다.",
          "children": [
            {
              "id": "PqcP4lPnFlKu",
              "text": "칸: 5 저장",
              "children": [],
              "isFolded": false,
              "createdAt": 1793170364660,
              "updatedAt": 1793170364660
            },
            {
              "id": "Ex7fsul2qpDJ",
              "text": "구분: 공통",
              "children": [],
