            },
            {
              "id": "lyRqwK5XxEr9",
              "text": "출처: [공식] git-scm.com/docs/git-revert",
              "children": [],
              "isFolded": false,
              "createdAt": 1793170625399,
              "updatedAt": 1793170625399
            },
            {
              "id": "y95Tpllnk090",
              "text": "링크: https://git-scm.com/docs/git-revert",
              "children": [],
              "isFolded": false,
              "createdAt": 1793176026356,
              "updatedAt": 1793176026356
            },
            {
