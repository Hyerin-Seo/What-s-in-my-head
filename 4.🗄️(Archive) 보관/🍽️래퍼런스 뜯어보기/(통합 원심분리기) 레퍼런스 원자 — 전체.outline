              "updatedAt": 1793176026356
            },
            {
              "id": "fEz7bIsofX40",
              "text": "📌 붙일 곳: 단계:5",
              "children": [],
              "isFolded": false,
              "createdAt": 1793170815802,
              "updatedAt": 1793170815802
            },
            {
              "id": "tHqaLVdRZ8l7",
              "text": "🔗 닿는 니즈: 없음",
              "children": [],
