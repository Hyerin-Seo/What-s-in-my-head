            },
            {
              "id": "5aoiPAI3q0Zp",
              "text": "📌 붙일 곳: 기본기",
              "children": [],
              "isFolded": false,
              "createdAt": 1793170364660,
              "updatedAt": 1793170364660
            },
            {
              "id": "beoPlBPN9pyt",
              "text": "🔗 닿는 니즈: 없음",
