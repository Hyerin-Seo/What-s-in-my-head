        {
          "id": "bYENGdbeK7JE",
          "text": "스냅샷 — 섹션의 스냅샷을 찍어 두면 언제든 그 버전으로 돌아간다.",
          "children": [
            {
              "id": "8Cw55SIteJwA",
              "text": "칸: 5 저장",
              "children": [],
              "isFolded": false,
              "createdAt": 1793170625399,
              "updatedAt": 1793170625399
            },
            {
              "id": "9NSMYqhx0stg",
              "text": "구분: 공통",
              "children": [],
              "isFolded": false,
              "createdAt": 1793170625399,
              "updatedAt": 1793170625399
            },
            {
              "id": "Y1Sq9VgL8auJ",
              "text": "출처: [공식] literatureandlatte.com/scrivener/features",
