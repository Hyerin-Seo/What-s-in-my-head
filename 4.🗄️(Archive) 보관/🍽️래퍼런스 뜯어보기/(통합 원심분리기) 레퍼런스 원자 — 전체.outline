          "isFolded": false,
          "createdAt": 1793170625399,
          "updatedAt": 1793170625399
        },
        {
          "id": "GaHkhYKtwiai",
          "text": "자료를 글 옆에 — PDF·웹 페이지·가져온 파일을 프로젝트 안에 두고 글 옆에서 본다.",
          "children": [
            {
              "id": "Ofsj1VUu89Ug",
              "text": "칸: 2 구조",
              "children": [],
              "isFolded": false,
              "createdAt": 1793170625399,
              "updatedAt": 1793170625399
            },
            {
              "id": "3LuKoCLaCE1O",
              "text": "구분: 공통",
              "children": [],
              "isFolded": false,
              "createdAt": 1793170625399,
              "updatedAt": 1793170625399
            },
            {
              "id": "gvbMgXkvl7Jd",
              "text": "출처: [공식] literatureandlatte.com/scrivener/features",
