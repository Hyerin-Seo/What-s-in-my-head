              "createdAt": 1793176026356,
              "updatedAt": 1793176026356
            },
            {
              "id": "I5cjQNZfVtJm",
              "text": "📌 붙일 곳: 단계:2",
              "children": [],
              "isFolded": false,
              "createdAt": 1793170364660,
              "updatedAt": 1793170364660
            },
            {
              "id": "Qo1AR7K0CwsV",
              "text": "🔗 닿는 니즈: 없음",
              "children": [],
              "isFolded": false,
              "createdAt": 1793170364660,
              "updatedAt": 1793170364660
            }
          ],
          "isFolded": false,
          "createdAt": 1793170364660,
          "updatedAt": 1793170364660
        },
        {
          "id": "rPOoNHKhKFrB",
          "text": "태그 눌러 거르기 — 태그를 누르면 그 태그가 붙은 것만 남는다.",
          "children": [
            {
              "id": "vaEVhTXfx2qm",
              "text": "칸: 3 조작",
              "children": [],
              "isFolded": false,
              "createdAt": 1793170364660,
              "updatedAt": 1793170364660
            },
            {
              "id": "Gv1fMHgk8Viw",
              "text": "구분: 공통",
              "children": [],
