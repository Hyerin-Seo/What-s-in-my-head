                              "updatedAt": 1792554073932
                            },
                            {
                              "id": "8jtzWkuqBBQj",
                              "text": "문장 비율",
                              "children": [
                                {
                                  "id": "l1VEHRKFMeOA",
                                  "text": "짧은 문장(5단어 이하)",
                                  "children": [],
                                  "isFolded": false,
                                  "createdAt": 1792554073932,
                                  "updatedAt": 1792554073932
                                },
                                {
                                  "id": "vILuNZ4aa5Hv",
