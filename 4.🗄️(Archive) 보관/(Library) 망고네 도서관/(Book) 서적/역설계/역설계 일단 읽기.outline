                            }
                          ],
                          "isFolded": true,
                          "createdAt": 1792554073932,
                          "updatedAt": 1792554073932
                        },
                        {
                          "id": "fNDGrodOKiZY",
                          "text": "메시지 전달력",
                          "children": [],
