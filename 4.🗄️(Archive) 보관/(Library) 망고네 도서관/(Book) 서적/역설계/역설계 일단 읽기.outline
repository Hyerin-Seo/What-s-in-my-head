                              "updatedAt": 1792554073932
                            },
                            {
                              "id": "A18cpbH05Ev5",
                              "text": "중립적 감정의 비율",
                              "children": [],
                              "isFolded": false,
                              "createdAt": 1792554073932,
                              "updatedAt": 1792554073932
                            },
                            {
                              "id": "MKOh1ctodsPj",
                              "text": "부정적 감정의 비율",
                              "children": [],
                              "isFolded": false,
