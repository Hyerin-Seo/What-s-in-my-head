filters:
  and:
    - file.ext == "md"
    - note["유형"] == "할일"
    - file.inFolder("4.🗄️(Archive) 보관/🚚 PARA 구축 — 자료 이식")
views:
  - type: kanban-view
    name: 🗂️ 칸반
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 4.🗄️(Archive) 보관/🚚 PARA 구축 — 자료 이식
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    cardOrders:
      note.상태:
        완료:
          - 4.🗄️(Archive) 보관/🚚 PARA 구축 — 자료 이식/😁MangoDoc_엔진설계/RAG 모듈 설계/스킬셋/(gen)목차 기반 인덱싱.md
        히스토리:
          - 4.🗄️(Archive) 보관/🚚 PARA 구축 — 자료 이식/[특명] 가오슝 숙소를 찾아라.md
        to do:
          - 1.🎯(Project) 프로젝트/🐛 버그 리포트/(개발 요청) 버그리포트 - 자동 작성기.md
          - 1.🎯(Project) 프로젝트/✏️문서 어시스턴트 에디터 목업/[개발 요청] Inbox - 일괄 PARA 보내기 기능.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/궁금한 질문 하나를 에이전트에게 맡겨 리서치 보고서 한 장 받아 보기.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/하루치 git 커밋으로 퇴근 보고 초안 뽑아 보기.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/Mem·Saner 30분씩 써 보고 우리 볼트에 가져올 기능 3개 적기.md
        진행중:
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/(rin) 그래서 우리가 무엇을 먼저 자동화 해야하는가.md
        확인 필요: []
        퍼즈:
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/데스크톱 반려 AI에게 맡길 일 하나 정해 클로드에게 시제품 부탁하기.md
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 Rin
    filters:
      and:
        - file.inFolder("4.🗄️(Archive) 보관/🚚 PARA 구축 — 자료 이식")
        - note["담당"].contains("[[Rin]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 4.🗄️(Archive) 보관/🚚 PARA 구축 — 자료 이식
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 민규 서
    filters:
      and:
        - file.inFolder("4.🗄️(Archive) 보관/🚚 PARA 구축 — 자료 이식")
        - note["담당"].contains("[[민규 서]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 4.🗄️(Archive) 보관/🚚 PARA 구축 — 자료 이식
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 미할당
    filters:
      and:
        - file.inFolder("4.🗄️(Archive) 보관/🚚 PARA 구축 — 자료 이식")
        - note["담당"].isEmpty()
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 4.🗄️(Archive) 보관/🚚 PARA 구축 — 자료 이식
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: table
    name: 📊 전체 표
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    sort:
      - property: 상태
        direction: ASC
    summaries:
      유형: Filled
  - type: cards
    name: 🎴 갤러리
    groupBy:
      property: 상태
      direction: ASC
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 210
newItemFolder: 4.🗄️(Archive) 보관/🚚 PARA 구축 — 자료 이식
newItemTemplate: 1.🎯(Project) 프로젝트/!(Template) 새 할 일.md
