filters:
  and:
    - file.ext == "md"
    - note["유형"] == "할일"
    - note["주제"].contains("회의 할 일")
    - not:
        - file.name.startsWith("!(Template)")
views:
  - type: table
    name: ⏳ 안 끝난 것
    filters:
      and:
        - note["상태"] != "완료"
        - note["상태"] != "히스토리"
    order:
      - file
      - 상태
      - 담당
      - 마감
      - 상위
    sort:
      - property: 마감
        direction: ASC
  - type: table
    name: 🔴 마감 지남
    filters:
      and:
        - note["상태"] != "완료"
        - note["상태"] != "히스토리"
        - note["마감"] < today()
    order:
      - file
      - 상태
      - 담당
      - 마감
      - 상위
    sort:
      - property: 마감
        direction: ASC
  - type: table
    name: 👤 Rin
    filters:
      and:
        - note["상태"] != "완료"
        - note["상태"] != "히스토리"
        - note["담당"].contains("[[Rin]]")
    order:
      - file
      - 상태
      - 담당
      - 마감
      - 상위
    sort:
      - property: 마감
        direction: ASC
  - type: table
    name: 👤 민규 서
    filters:
      and:
        - note["상태"] != "완료"
        - note["상태"] != "히스토리"
        - note["담당"].contains("[[민규 서]]")
    order:
      - file
      - 상태
      - 담당
      - 마감
      - 상위
    sort:
      - property: 마감
        direction: ASC
  - type: table
    name: 👤 미할당
    filters:
      and:
        - note["상태"] != "완료"
        - note["상태"] != "히스토리"
        - note["담당"].isEmpty()
    order:
      - file
      - 상태
      - 담당
      - 마감
      - 상위
    sort:
      - property: 마감
        direction: ASC
  - type: table
    name: 📝 회의별
    order:
      - 상위
      - file
      - 상태
      - 담당
      - 마감
    sort:
      - property: 상위
        direction: DESC
  - type: table
    name: ✅ 끝난 것
    filters:
      and:
        - note["상태"] == "완료"
    order:
      - file
      - 담당
      - 상위
    sort:
      - property: file.mtime
        direction: DESC
newItemFolder: 0.📥 인박스/📝 회의록 인박스
newItemTemplate: 0.📥 인박스/!(Template) 회의 할 일.md
