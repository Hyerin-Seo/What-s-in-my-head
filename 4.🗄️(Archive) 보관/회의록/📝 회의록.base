filters:
  and:
    - file.ext == "md"
    - note["분류"].contains("회의록")
    - not:
        - file.name.startsWith("!(Template)")
views:
  - type: table
    name: 📝 회의록
    order:
      - file
      - 작성일
      - 요약
    sort:
      - property: 작성일
        direction: DESC
newItemFolder: 4.🗄️(Archive) 보관/회의록
newItemTemplate: 4.🗄️(Archive) 보관/회의록/!(Template) 회의록.md
