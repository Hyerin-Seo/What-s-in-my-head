		{"id":"nuance","type":"text","text":"## ① 느낌·뉘앙스 전달","x":-890,"y":-565,"width":320,"height":75,"color":"6"},
		{"id":"nuance_0","type":"text","text":"자유로운 레퍼런스\n명확한 공식 없음","x":-1050,"y":-450,"width":310,"height":85},
		{"id":"nuance_1","type":"text","text":"원하는 느낌\n말로 정의하기 어려움","x":-720,"y":-450,"width":310,"height":85},
		{"id":"nuance_2","type":"text","text":"의도 엇갈림\n“아니야” 수십 번","x":-1050,"y":-345,"width":310,"height":85},
		{"id":"nuance_3","type":"text","text":"싱크 맞추기\n설명보다 정정 반복","x":-720,"y":-345,"width":310,"height":85},
		{"id":"nuance_4","type":"text","text":"텍스트 Before/After\n차이·효과 판단 어려움","x":-1050,"y":-240,"width":310,"height":85},
		{"id":"nuance_5","type":"text","text":"형식은 비슷한데\n원했던 설명 방식은 다름","x":-720,"y":-240,"width":310,"height":85},
		{"id":"topic","type":"text","text":"## ② 소재·독자·재미","x":570,"y":-565,"width":320,"height":75,"color":"2"},
		{"id":"topic_0","type":"text","text":"소재 미정\n시작부터 막막","x":410,"y":-450,"width":310,"height":85},
		{"id":"topic_1","type":"text","text":"70~80% 그럴듯\n막상 쓰면 노잼","x":740,"y":-450,"width":310,"height":85},
		{"id":"topic_2","type":"text","text":"독자 관점 부족\n“그래서 어쩌라고?”","x":410,"y":-345,"width":310,"height":85},
		{"id":"topic_3","type":"text","text":"감성·흥미 부족\n내용 연결 안 됨","x":740,"y":-345,"width":310,"height":85},
		{"id":"writing_0","type":"text","text":"Claude\n볼트·노트 정리 잘함","x":-1050,"y":340,"width":310,"height":85},
		{"id":"writing_2","type":"text","text":"Codex\n레퍼런스 느낌은 상대적 이해","x":-1050,"y":445,"width":310,"height":85},
		{"id":"topic_4","type":"text","text":"후보는 많아도 선택은 막막\n26개 후보 → 오후 전량 폐기","x":410,"y":-240,"width":310,"height":85},
		{"id":"topic_5","type":"text","text":"우리 볼트 얘기만 반복\n독자가 가져갈 것 없음","x":740,"y":-240,"width":310,"height":85},
		{"id":"writing","type":"text","text":"## ③ 글 품질·도구 편차","x":-890,"y":225,"width":320,"height":75,"color":"4"},
		{"id":"writing_1","type":"text","text":"Claude 글\n엉망 · 번역투","x":-720,"y":340,"width":310,"height":85},
		{"id":"writing_3","type":"text","text":"둘 다\n한국어인데 해독 필요","x":-720,"y":445,"width":310,"height":85},
		{"id":"cowork","type":"text","text":"## ④ 코워크 대신 중간 전달자","x":570,"y":225,"width":320,"height":75,"color":"5"},
		{"id":"cowork_0","type":"text","text":"자료 지정 반복\n폴더 경로 복붙","x":410,"y":340,"width":310,"height":85},
		{"id":"cowork_1","type":"text","text":"맥락·선택 전달\n다시 설명","x":740,"y":340,"width":310,"height":85},
		{"id":"cowork_2","type":"text","text":"함께 만든다는 느낌 부족\n수정 부담은 사람","x":410,"y":445,"width":310,"height":85},
		{"id":"cowork_3","type":"text","text":"내 의도 → AI 지시\n사이에서 API 역할","x":740,"y":445,"width":310,"height":85},
		{"id":"reflection","type":"text","text":"디렉션 부족도 인정\n그런데 어떻게 줘야 할지 모름","x":-170,"y":195,"width":340,"height":115,"color":"3"},
		{"id":"core","type":"text","text":"## 핵심 불편\n정리 안 된 의도를\n함께 구체화하기 어려움","x":-170,"y":395,"width":340,"height":150,"color":"3"},
		{"id":"rework","type":"text","text":"## ⑤ 지시 이탈·재작업","x":-180,"y":820,"width":360,"height":75,"color":"1"},
		{"id":"rework_0","type":"text","text":"요청보다 앞서 감\n구조 분석 → 시리즈까지 결정","x":-665,"y":940,"width":310,"height":100},
		{"id":"rework_1","type":"text","text":"합의한 구조 다시 이탈\n1:1 대응 재검사 요구","x":-325,"y":940,"width":310,"height":100},
		{"id":"rework_2","type":"text","text":"불편의 원인 잘못 짚음\n노잼 소재 → 예시만 추가","x":15,"y":940,"width":310,"height":100},
		{"id":"rework_3","type":"text","text":"검토·정정 부담 누적\n약 2시간 40분 → 채택 0","x":355,"y":940,"width":310,"height":100},
