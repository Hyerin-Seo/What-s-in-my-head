filters:
  and:
    - file.ext == "md"
    - 유형 != "양식"
    - 분류.contains("UI + 디자인 + 기술 레퍼런스")
views:
  - type: cards
    name: 🪄 단계별
    groupBy:
      property: 상태
      direction: ASC
    order:
      - file
      - 요약
      - 주제
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 210
  - type: table
    name: 📊 전체 표
    order:
      - file
      - 상태
      - 주제
      - 요약
      - 링크
      - 담당
      - 작성자
      - 작성일
    sort:
      - property: 작성일
        direction: DESC
    summaries:
      유형: Filled
  - type: table
    name: 🕳️ 정리 필요
    filters:
      or:
        - note["요약"].isEmpty()
        - note["커버"].isEmpty()
    order:
      - file
      - 요약
      - 커버
newItemFolder: 4.🗄️(Archive) 보관/UI + 디자인 + 기술 레퍼런스
