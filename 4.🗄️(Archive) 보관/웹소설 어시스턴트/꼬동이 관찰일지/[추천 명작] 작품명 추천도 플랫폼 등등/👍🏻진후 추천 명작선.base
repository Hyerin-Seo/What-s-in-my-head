filters:
  and:
    - note["유형"] == "작품"
views:
  - type: table
    name: 👍🏻 추천 명작선
    order:
      - file
      - 분류
      - 주제
      - 원래 중요도
      - 추천자
      - 작성자
      - 링크
    sort:
      - property: 원래 중요도
        direction: ASC
    summaries:
      유형: Filled
  - type: cards
    name: 🏆 추천도별
    groupBy:
      property: 원래 중요도
      direction: ASC
    order:
      - file
      - 분류
      - 링크
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 190
newItemFolder: 4.🗄️(Archive) 보관/웹소설 어시스턴트/꼬동이 관찰일지/[추천 명작] 작품명 추천도 플랫폼 등등
