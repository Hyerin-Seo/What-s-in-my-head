filters:
  and:
    - note["유형"] == "작품"
views:
  - type: table
    name: 👍🏻 추천 명작선
    order:
      - file.file
      - 분류
      - 주제
      - 중요도
      - 추천자
      - 작성자
      - 링크
    sort:
      - property: 중요도
        direction: ASC
    summaries:
      제목: Filled
  - type: cards
    name: 🏆 추천도별
    groupBy:
      property: 중요도
      direction: ASC
    order:
      - 제목
      - 분류
      - 링크
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 190
