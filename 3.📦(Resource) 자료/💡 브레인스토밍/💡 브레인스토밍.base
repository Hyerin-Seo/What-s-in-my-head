filters:
  and:
    - file.ext == "md"
    - note["유형"] == "아이디어"
    - not:
        - file.name == "[아이디어] 제목"
views:
  - type: cards
    name: 🪄 단계별
    groupBy:
      property: 상태
      direction: ASC
    order:
      - file
      - 요약
      - 분류
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 210
  - type: cards
    name: 🗂️ 분류별
    groupBy:
      property: 분류
      direction: ASC
    order:
      - file
      - 요약
    image: 커버
    imageAspectRatio: 0.667
    imageFit: contain
    cardSize: 180
  - type: cards
    name: 🔥 둘 다 8점 이상
    filters:
      and:
        - note["망고's 점수"] >= 8
        - note["개린's 점수"] >= 8
    order:
      - file
      - 요약
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 250
  - type: table
    name: 📊 모든 아이디어
    order:
      - file
      - 상태
      - 분류
      - 요약
      - 링크
      - 망고's 점수
      - 개린's 점수
      - 담당
      - 작성자
      - 작성일
    sort:
      - property: 작성일
        direction: DESC
    summaries:
      유형: Filled
      망고's 점수: Average
      개린's 점수: Average
newItemFolder: 3.📦(Resource) 자료/💡 브레인스토밍
