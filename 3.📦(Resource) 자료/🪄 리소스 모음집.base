filters:
  and:
    - file.ext == "md"
    - note["구역"] == "3.resource"
    - note["유형"] != "양식"
    - note["유형"] != "홈"
views:
  - type: table
    name: 📚 자료 목록
    groupBy:
      property: 분류
      direction: ASC
    order:
      - file
      - 유형
      - 요약
      - 작성일
    sort:
      - property: 작성일
        direction: DESC
newItemFolder: 3.📦(Resource) 자료
