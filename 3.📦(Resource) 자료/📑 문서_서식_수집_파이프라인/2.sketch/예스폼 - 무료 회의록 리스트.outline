        },
        {
          "id": "0OQlL7L4QwTJ",
          "text": "07. [반상회 회의록 무료샘플 및 무료서식 다운로드](https://www.yesform.com/forms/vform_159439.php)",
          "children": [
            {
              "id": "A2ENPZr05jbj",
              "text": "서식 ID: vform_159439",
              "children": [],
              "isFolded": false,
              "createdAt": 1793001034898,
              "updatedAt": 1793001034898
            },
            {
              "id": "SdVaCQSw8Gft",
              "text": "지원 포맷: 한글, 워드, PDF",
              "children": [],
              "isFolded": false,
              "createdAt": 1793001034898,
              "updatedAt": 1793001034898
            },
            {
