filters:
  and:
    - file.ext == "md"
    - note["유형"] == "할일"
    - file.inFolder("1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식")
views:
  - type: kanban-view
    name: 🗂️ 칸반
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    cardOrders:
      note.상태:
        완료:
          - 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식/😁MangoDoc_엔진설계/RAG 모듈 설계/스킬셋/(gen)목차 기반 인덱싱.md
        히스토리:
          - 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식/[특명] 가오슝 숙소를 찾아라.md
        to do:
          - 1.🎯(Project) 프로젝트/🐛 버그 리포트/(개발 요청) 버그리포트 - 자동 작성기.md
          - 1.🎯(Project) 프로젝트/✏️문서 어시스턴트 에디터 목업/[개발 요청] Inbox - 일괄 PARA 보내기 기능.md
          - 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식/리서치 에이전트 구축.md
          - 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식/자동 퇴근 요정 구축.md
          - 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식/AI 사서 시스템 구축.md
        진행중:
          - 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식/(rin) 그래서 우리가 무엇을 먼저 자동화 해야하는가.md
        확인 필요: []
        퍼즈:
          - 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식/데스크톱 ai 에이전트 구축.md
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 Rin
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식")
        - note["담당"].contains("[[Rin]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 민규 서
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식")
        - note["담당"].contains("[[민규 서]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 미할당
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식")
        - note["담당"].isEmpty()
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: table
    name: 📊 전체 표
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    sort:
      - property: 상태
        direction: ASC
    summaries:
      유형: Filled
  - type: cards
    name: 🎴 갤러리
    groupBy:
      property: 상태
      direction: ASC
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 210
newItemFolder: 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식
newItemTemplate: 1.🎯(Project) 프로젝트/!(Template) 새 할 일.md
