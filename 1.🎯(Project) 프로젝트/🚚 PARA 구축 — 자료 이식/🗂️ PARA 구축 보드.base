filters:
  and:
    - file.ext == "md"
    - note["유형"] == "할일"
    - file.inFolder("1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식")
views:
  - type: kanban-view
    name: 🗂️ 칸반
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    cardOrders:
      note.상태:
        완료:
          - 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식/(idea) 클로드만 mcp 물리냐! 제미나이도 물리도!.md
        히스토리:
          - 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식/[특명] 가오슝 숙소를 찾아라.md
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 Rin
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식")
        - note["담당"].contains("[[Rin]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 민규 서
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식")
        - note["담당"].contains("[[민규 서]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 미할당
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식")
        - note["담당"].isEmpty()
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: table
    name: 📊 전체 표
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    sort:
      - property: 상태
        direction: ASC
    summaries:
      유형: Filled
  - type: cards
    name: 🎴 갤러리
    groupBy:
      property: 상태
      direction: ASC
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 210
newItemFolder: 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식
newItemTemplate: 1.🎯(Project) 프로젝트/!(Template) 새 할 일.md
