		{"id":"c4e58dc6c4e8072c","fromNode":"9bca4f47525964c0","fromSide":"bottom","toNode":"bb5b3723c57dbffa","toSide":"top"},
		{"id":"197b24dd2f96ff36","fromNode":"9bca4f47525964c0","fromSide":"bottom","toNode":"4c3e92149cc7b4e3","toSide":"top"},
		{"id":"d63f4a0685089d4d","fromNode":"9bca4f47525964c0","fromSide":"bottom","toNode":"0ac75f7af7fc7a92","toSide":"top"},
		{"id":"6642358f0c63b5cf","fromNode":"531c487129c4ace8","fromSide":"bottom","toNode":"4c3e92149cc7b4e3","toSide":"bottom","label":"어떤 고통을 없앨 것인가?"},
		{"id":"7d6be55ddc732824","fromNode":"4c3e92149cc7b4e3","fromSide":"bottom","toNode":"8e236bd35412fef8","toSide":"bottom","label":"인간과 기계의 관계를 어떻게 재설정하는가?"},
		{"id":"78a1825843f9174e","fromNode":"8e236bd35412fef8","fromSide":"bottom","toNode":"bb5b3723c57dbffa","toSide":"bottom","label":"이를 가능케 하는 최소 조작 단위는 무엇인가?"},
		{"id":"ab42fb39d6256bec","fromNode":"bb5b3723c57dbffa","fromSide":"bottom","toNode":"0ac75f7af7fc7a92","toSide":"bottom","label":"가장 날카롭게 비집고 들어갈 접점은 어디인가?"},
