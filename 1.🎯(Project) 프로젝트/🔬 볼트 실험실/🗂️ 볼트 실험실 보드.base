filters:
  and:
    - file.ext == "md"
    - note["유형"] == "할일"
    - note["상태"] != "결정 사항"
    - file.inFolder("1.🎯(Project) 프로젝트/🔬 볼트 실험실")
    - not:
        - file.name.startsWith("!(Template)")
views:
  - type: kanban-view
    name: 🗂️ 전체
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🔬 볼트 실험실
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
    cardOrders:
      note.상태:
        to do: []
        진행중: []
        확인 필요: []
        퍼즈:
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(인박스-cli 연동)인박스 cli 연동 안됨쓰.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/레퍼런스 훑어보고 뜯어 볼 도구 하나 고르기.md
        완료:
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/양식이 안 물린 보드의 + 로 만든 노트는 속성이 반쯤 없다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/다음 회의를 속기하고 meeting-notes 스킬로 할일 배포까지 해 보기.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/gtd + para + ai 아 이놈들을 대체 어떻게 알잘딱하게 엮을 것인가에 대하여 샹.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(개발 요청) 버그리포트 - 자동 작성기.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(calendar)날짜 표시 버그.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(comment)대댓글은 슬랙 알람 안됨요.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(Inbox) 대시보드 삽입 이슈.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(modal&화면split)상세 창이 안열림&split 시 칸반 이동 안됨.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(PARA보내기)하위 디렉토리로 이동 못함.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/(rin) 그래서 우리가 무엇을 먼저 자동화 해야하는가.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/3. resource 표의 보드 링크를 눌러도 보드가 안 열린다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/09.30 같은 폴더 이름이 분류에 숫자 9.3 으로 들어간다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/고친 버그 3개(칸반 빈 폴더·작성자 고정·빈 분류) 확인하기.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/동기화할 때 한글 파일 이름이 가끔 깨진 글자로 나올 수 있다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/레퍼런스 카드의 UI + 디자인 레퍼런스 링크가 안 열린다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/망고네 도서관 base에서 신규 추가 누르면 기존 폴더가 아닌 새로운 이상한 폴더를 만들어서 하위로 꼽힌다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/보관으로 내린 프로젝트 보드가 구역 필터 때문에 통째로 빈다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/보드에서 만든 카드의 작성자가 Claude 로 찍힌다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/스크립트로 고친 노트에 속성이 조용히 안 써진다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/인박스 안에 회의록 인박스 만들기.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/인박스 핀보드 카드에 노트 제목이 안 나온다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/인박스로 옮긴 노트의 주제가 agy 키워드로 바뀐다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/지운 글 퍼먹기 먐먐 캔버스와 .bak 이 자꾸 되살아난다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/책장에서 책을 추가해도 책 폴더와 이미지 폴더가 안 생긴다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/충돌 66개 하나하나 풀어야함 ㅠ.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/칸반 + 를 누르면 빈 폴더가 두 겹 생긴다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/캔버스를 만들어도 어느 보드에도 안 뜬다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/프로젝트 폴더 안의 99 작업 공간 노트가 ⚠ PARA 와 보드에 뜬다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/프로젝트 폴더를 보관으로 옮겨도 프로젝트 보드에 탭이 남는다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/플러그인을 업데이트하면 동기화 버튼이 사라진다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/회의록 decision SKILL 피드백 요청.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/Claude가 바꾼 실험실 정리 확인하기.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/pull 받기 전 마지막 점검.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/route.py --repair 가 skills 폴더의 스킬 파일을 어긋났다고 잡는다.md
  - type: kanban-view
    name: 👤 Rin
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🔬 볼트 실험실")
        - note["담당"].contains("[[Rin]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🔬 볼트 실험실
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 민규 서
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🔬 볼트 실험실")
        - note["담당"].contains("[[민규 서]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🔬 볼트 실험실
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 미할당
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🔬 볼트 실험실")
        - note["담당"].isEmpty()
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🔬 볼트 실험실
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: table
    name: 📊 전체 표
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
newItemFolder: 1.🎯(Project) 프로젝트/🔬 볼트 실험실
newItemTemplate: 1.🎯(Project) 프로젝트/!(Template) 새 할 일.md
