		{"id":"ec3d4e5f6a7b0a30","fromNode":"c0a1b2c3d4e5f607","fromSide":"bottom","toNode":"f0a1b2c3d4e5f608","toSide":"top","color":"2","label":"절대 필수 조건 검증 (Non-negotiable Filter)"},
