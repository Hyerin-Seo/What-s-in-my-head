filters:
  and:
    - file.ext == "md"
    - note["유형"] == "할일"
    - note["상태"] != "결정 사항"
    - note["구역"] == "1.project"
    - not:
        - file.name.startsWith("!(Template)")
views:
  - type: kanban-view
    name: 🔥 지금 할 것
    filters:
      or:
        - note["상태"] != "to do"
        - and:
            - not:
                - note["일정"].isEmpty()
            - note["일정"] <= today()
        - and:
            - note["일정"].isEmpty()
            - or:
                - note["마감"].isEmpty()
                - note["마감"] <= today() + "14d"
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
    cardOrders:
      note.상태:
        to do: []
        진행중:
          - 1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리/discussions/26.10.02/new todo/value_Recipe 사양의 고객 검증.md
