filters:
  and:
    - file.ext == "md"
    - note["유형"] == "할일"
    - note["구역"] == "1.project"
    - not:
        - file.name.startsWith("!(Template)")
views:
  - type: kanban-view
    name: 🗂️ 전체
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
        - Uncategorized
    columnColors:
      note.상태: {}
    cardOrders:
      note.상태: {}
  - type: kanban-view
    name: 🚚 PARA 구축 — 자료 이식
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🚚 PARA 구축 — 자료 이식
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 🧪 문서 어시스턴트 프로토타입 구현
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🧪 문서 어시스턴트 프로토타입 구현")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🧪 문서 어시스턴트 프로토타입 구현
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 Rin
    filters:
      and:
        - note["담당"].contains("[[Rin]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 민규 서
    filters:
      and:
        - note["담당"].contains("[[민규 서]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 미할당
    filters:
      and:
        - note["담당"].isEmpty()
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: table
    name: ⏰ 마감 가까운 순
    filters:
      and:
        - not:
            - note["마감"].isEmpty()
        - note["상태"] != "완료"
        - note["상태"] != "히스토리"
    order:
      - file
      - 마감
      - 상태
      - 담당
      - 작성자
    sort:
      - property: 마감
        direction: ASC
  - type: table
    name: 📅 하는 날이 잡힌 것
    filters:
      and:
        - not:
            - note["일정"].isEmpty()
        - note["상태"] != "완료"
        - note["상태"] != "히스토리"
    order:
      - file
      - 일정
      - 마감
      - 상태
      - 담당
    sort:
      - property: 일정
        direction: ASC
  - type: table
    name: ⏳ 확인 필요
    filters:
      and:
        - note["상태"] == "확인 필요"
    order:
      - file
      - 담당
      - 마감
      - 작성자
      - file.mtime
    sort:
      - property: file.mtime
        direction: ASC
  - type: table
    name: ⏳ 남이 갖고 있는 것
    filters:
      and:
        - not:
            - note["담당"].isEmpty()
        - not:
            - note["작성자"].isEmpty()
        - not:
            - note["작성자"].containsAll(note["담당"])
        - note["상태"] != "완료"
        - note["상태"] != "히스토리"
    order:
      - file
      - 상태
      - 담당
      - 작성자
      - 마감
      - file.mtime
    sort:
      - property: file.mtime
        direction: ASC
    summaries:
      유형: Filled
  - type: table
    name: 🕳️ 상태가 빈 것
    filters:
      and:
        - note["상태"].isEmpty()
    order:
      - file
      - 상태
      - 분류
      - 담당
      - 마감
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: 📊 전체 표
    order:
      - file
      - 상태
      - 담당
      - 마감
      - 작성자
      - file.mtime
    sort:
      - property: 상태
        direction: ASC
    summaries:
      유형: Filled
  - type: cards
    name: 🎴 갤러리
    groupBy:
      property: 상태
      direction: ASC
    order:
      - file
      - 담당
      - 마감
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 220
newItemFolder: 1.🎯(Project) 프로젝트
newItemTemplate: 1.🎯(Project) 프로젝트/!(Template) 새 할 일.md
