filters:
  and:
    - file.ext == "md"
    - note["유형"] == "할일"
    - note["구역"] == "1.project"
    - not:
        - file.name.startsWith("!(Template)")
views:
  - type: kanban-view
    name: 🔥 지금 할 것
    filters:
      or:
        - note["상태"] != "to do"
        - and:
            - not:
                - note["일정"].isEmpty()
            - note["일정"] <= today()
        - and:
            - note["일정"].isEmpty()
            - or:
                - note["마감"].isEmpty()
                - note["마감"] <= today() + "14d"
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
    cardOrders:
      note.상태:
        to do:
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(인박스-cli 연동)인박스 cli 연동 안됨쓰.md
          - 1.🎯(Project) 프로젝트/🧺 챙길 일/은행에 법인카드 발급 서류 물어보고 신청하기.md
        진행중:
          - 1.🎯(Project) 프로젝트/💻문서 어시스턴트 동작 구현/(layout 정비) IDE 패널 정비.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/gtd + para + ai 아 이놈들을 대체 어떻게 알잘딱하게 엮을 것인가에 대하여 샹.md
        확인 필요:
          - 0.📥 인박스/🥭 망고 인박스/[개발 요청] 옵시디언 에이전트 백엔드 워크플로우 세팅하기.md
  - type: kanban-view
    name: 🧪 문서 어시스턴트 프로토타입 구현
    filters:
      and:
        - file.inFolder("4.🗄️(Archive) 보관/🧪 문서 어시스턴트 프로토타입 구현")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 4.🗄️(Archive) 보관/🧪 문서 어시스턴트 프로토타입 구현
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 🔬 볼트 실험실
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🔬 볼트 실험실")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🔬 볼트 실험실
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 Rin
    filters:
      and:
        - note["담당"].contains("[[Rin]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
    cardOrders:
      note.상태:
        to do:
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(인박스-cli 연동)인박스 cli 연동 안됨쓰.md
        진행중:
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/다음 회의를 속기하고 meeting-notes 스킬로 할일 배포까지 해 보기.md
        확인 필요: []
        완료:
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/고친 버그 3개(칸반 빈 폴더·작성자 고정·빈 분류) 확인하기.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/Claude가 바꾼 실험실 정리 확인하기.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(개발 요청) 버그리포트 - 자동 작성기.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(modal&화면split)상세 창이 안열림&split 시 칸반 이동 안됨.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(PARA보내기)하위 디렉토리로 이동 못함.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/(rin) 그래서 우리가 무엇을 먼저 자동화 해야하는가.md
          - 1.🎯(Project) 프로젝트/✏️문서 어시스턴트 에디터 목업/[개발 요청] Inbox - 일괄 PARA 보내기 기능.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/3. resource 표의 보드 링크를 눌러도 보드가 안 열린다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/망고네 도서관 base에서 신규 추가 누르면 기존 폴더가 아닌 새로운 이상한 폴더를 만들어서 하위로 꼽힌다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/보드에서 만든 카드의 작성자가 Claude 로 찍힌다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/스크립트로 고친 노트에 속성이 조용히 안 써진다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/지운 글 퍼먹기 먐먐 캔버스와 .bak 이 자꾸 되살아난다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/책장에서 책을 추가해도 책 폴더와 이미지 폴더가 안 생긴다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/칸반 + 를 누르면 빈 폴더가 두 겹 생긴다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/캔버스를 만들어도 어느 보드에도 안 뜬다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/pull 받기 전 마지막 점검.md
  - type: kanban-view
    name: 👤 민규 서
    filters:
      and:
        - note["담당"].contains("[[민규 서]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 미할당
    filters:
      and:
        - note["담당"].isEmpty()
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 🗂️ 전체
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
    cardOrders:
      note.상태:
        진행중: []
        to do:
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(인박스-cli 연동)인박스 cli 연동 안됨쓰.md
        완료:
          - 4.🗄️(Archive) 보관/🧪 문서 어시스턴트 프로토타입 구현/(Draw)기초 설계.md
          - 4.🗄️(Archive) 보관/🧪 문서 어시스턴트 프로토타입 구현/(Draw)에이전트 시대 업무 환경 변화.md
          - 4.🗄️(Archive) 보관/🧪 문서 어시스턴트 프로토타입 구현/(draw)워크플로우 심층 해체.md
          - 4.🗄️(Archive) 보관/🧪 문서 어시스턴트 프로토타입 구현/(Draw)LLM Brain 해체.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/3. resource 표의 보드 링크를 눌러도 보드가 안 열린다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/망고네 도서관 base에서 신규 추가 누르면 기존 폴더가 아닌 새로운 이상한 폴더를 만들어서 하위로 꼽힌다.md
          - 4.🗄️(Archive) 보관/🚚 PARA 구축 — 자료 이식/망고에게 개똥이 머릿속 이식 작업.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/보드에서 만든 카드의 작성자가 Claude 로 찍힌다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/스크립트로 고친 노트에 속성이 조용히 안 써진다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/지운 글 퍼먹기 먐먐 캔버스와 .bak 이 자꾸 되살아난다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/책장에서 책을 추가해도 책 폴더와 이미지 폴더가 안 생긴다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/칸반 + 를 누르면 빈 폴더가 두 겹 생긴다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/캔버스를 만들어도 어느 보드에도 안 뜬다.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/pull 받기 전 마지막 점검.md
          - 1.🎯(Project) 프로젝트/✏️문서 어시스턴트 에디터 목업/[할일] 페이지 뷰 수평 스크롤 및 그리드 뷰 모드 구현.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(개발 요청) 버그리포트 - 자동 작성기.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(modal&화면split)상세 창이 안열림&split 시 칸반 이동 안됨.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/🐛 버그 리포트/(PARA보내기)하위 디렉토리로 이동 못함.md
          - 1.🎯(Project) 프로젝트/✏️문서 어시스턴트 에디터 목업/[개발 요청] Inbox - 일괄 PARA 보내기 기능.md
          - 1.🎯(Project) 프로젝트/✏️문서 어시스턴트 에디터 목업/[할일] 리소스 매니저 패널 및 뷰모드 레이아웃 배치.md
          - 1.🎯(Project) 프로젝트/✏️문서 어시스턴트 에디터 목업/patch_note_resource_manager_rectangular_styling.md
          - 1.🎯(Project) 프로젝트/✏️문서 어시스턴트 에디터 목업/patch_note_resource_manager_scrollbar_and_thumbnails.md
          - 1.🎯(Project) 프로젝트/✏️문서 어시스턴트 에디터 목업/[할일] 레퍼런스 뷰 좌측 패널 및 모달 시스템.md
          - 1.🎯(Project) 프로젝트/✏️문서 어시스턴트 에디터 목업/ai 패널 사양잡기.md
          - 1.🎯(Project) 프로젝트/✏️문서 어시스턴트 에디터 목업/(seo) editor-workspace 실험.md
        확인 필요: []
        퍼즈:
          - 4.🗄️(Archive) 보관/🧪 문서 어시스턴트 프로토타입 구현/(draw) 볼트 칸반을 참고해 비동기 지시 스토리보드 VER2 이어 그리기.md
          - 1.🎯(Project) 프로젝트/🔬 볼트 실험실/데스크톱 반려 AI에게 맡길 일 하나 정해 클로드에게 시제품 부탁하기.md
  - type: kanban-view
    name: ✏️문서 어시스턴트 에디터 목업
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/✏️문서 어시스턴트 에디터 목업")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
