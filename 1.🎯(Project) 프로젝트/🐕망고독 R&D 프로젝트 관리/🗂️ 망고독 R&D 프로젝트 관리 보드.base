filters:
  and:
    - file.ext == "md"
    - note["유형"] == "할일"
    - file.inFolder("1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리")
    - not:
        - file.name.startsWith("!(Template)")
views:
  - type: kanban-view
    name: 🗂️ 전체
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
    cardOrders:
      note.상태:
        to do: []
        진행중:
          - 1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리/Value 검증 방법 짜기_모의 고객군.md
        확인 필요: []
        완료:
          - 1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리/망고독 Outcome 01·린 캔버스 — 이해한 것과 민규 서에게 물어볼 것.md
        퍼즈:
          - 1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리/Outcome 01 — 북극성 성과 정의 및 4대 리스크 스크리닝.ver1.md
          - 1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리/(gen)Risk 01 — Value Risk (전환 가치 및 지불 의향 검증).md
          - 1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리/🎯 (Outcome) 북극성 Outcome 정의 및 4대 리스크 스크리닝.md
          - 1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리/(gen)Risk 02 — Usability Risk (Composer 인터랙션 및 조작성 검증).md
        히스토리:
          - 1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리/프로토타입 01 — 바이브 코딩(Vibe Coding) 인터랙티브 프로토타입 (정성적 WTS·WTP 실측 프로토콜).md
  - type: kanban-view
    name: 👤 Rin
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리")
        - note["담당"].contains("[[Rin]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 민규 서
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리")
        - note["담당"].contains("[[민규 서]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 미할당
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리")
        - note["담당"].isEmpty()
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: table
    name: 📊 전체 표
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
newItemFolder: 1.🎯(Project) 프로젝트/🐕망고독 R&D 프로젝트 관리
newItemTemplate: 1.🎯(Project) 프로젝트/!(Template) 새 할 일.md
