                }
              ],
              "isFolded": true,
              "createdAt": 1793766168899,
              "updatedAt": 1793769252445
            },
            {
              "id": "e3LQ82vcKjPn",
              "text": "Phase 별 조절",
              "children": [
                {
                  "id": "fFDd6uknWH2G",
                  "text": "Phase1",
                  "children": [
                    {
                      "id": "tbF3P0CFo1Nr",
