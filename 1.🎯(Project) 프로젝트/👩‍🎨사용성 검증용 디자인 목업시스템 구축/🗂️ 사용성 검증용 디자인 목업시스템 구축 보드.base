filters:
  and:
    - file.ext == "md"
    - note["유형"] == "할일"
    - note["상태"] != "결정 사항"
    - file.inFolder("1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축")
    - not:
        - file.name.startsWith("!(Template)")
views:
  - type: kanban-view
    name: 🗂️ 전체
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
        - in progress
    columnColors:
      note.상태: {}
    cardOrders:
      note.상태:
        to do:
          - 1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축/(TODO 1-4) Storyflow·Flowith 캔버스 인터랙션 모델 분석 및 목업 도입 검토.md
          - 1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축/(TODO 1-5) Google AI Studio 기반 3대 서식 추천 프롬프트 및 JSON 스키마 신속 프로토타이핑.md
        진행중:
          - 1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축/(TODO) Storybook·Figma·Mobbin MCP 연계 기반 사용성 검증 디자인 목업 시스템 구축.md
          - 1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축/(TODO 1-2) Figma MCP 기반 30분 컷 레이아웃 시각화 및 와꾸 프레임 설계.md
        완료: []
        히스토리:
          - 1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축/(TODO 1-1) Mobbin MCP 연동 및 B2B SaaS 데스크톱 웹 레퍼런스 수집 체계 구축.md
          - 1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축/(TODO 1-3) Storybook MCP 애드온 설치 및 4대 사용성 검증 스토리 구축.md
        확인 필요: []
        퍼즈: []
  - type: kanban-view
    name: 👤 Rin
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축")
        - note["담당"].contains("[[Rin]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 민규 서
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축")
        - note["담당"].contains("[[민규 서]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 미할당
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축")
        - note["담당"].isEmpty()
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: table
    name: 📊 전체 표
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
newItemFolder: 1.🎯(Project) 프로젝트/👩‍🎨사용성 검증용 디자인 목업시스템 구축
newItemTemplate: 1.🎯(Project) 프로젝트/!(Template) 새 할 일.md
