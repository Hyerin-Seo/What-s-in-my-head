filters:
  and:
    - file.ext == "md"
    - note["유형"] == "할일"
    - file.inFolder("1.🎯(Project) 프로젝트/🧺 챙길 일")
    - not:
        - file.name.startsWith("!(Template)")
views:
  - type: kanban-view
    name: 🗂️ 전체
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🧺 챙길 일
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
    cardOrders:
      note.상태:
        to do:
          - 1.🎯(Project) 프로젝트/🧺 챙길 일/10.20~10.24 할머니 서울 일정.md
          - 1.🎯(Project) 프로젝트/🧺 챙길 일/2026. 10.14 오후 2시반 연세척병원 방문.md
          - 1.🎯(Project) 프로젝트/🧺 챙길 일/2026.10.19 오전 11시 대동병원 방문.md
          - 1.🎯(Project) 프로젝트/🧺 챙길 일/은행에 법인카드 발급 서류 물어보고 신청하기.md
        진행중:
          - 1.🎯(Project) 프로젝트/🧺 챙길 일/2026.09.29 모름시 연세척병원 큰엄마 허리 수술.md
        히스토리:
          - 1.🎯(Project) 프로젝트/🧺 챙길 일/2026. 10.14 오후 2시반 연세척병원 방문.md
          - 1.🎯(Project) 프로젝트/🧺 챙길 일/2026.09.29 모름시 연세척병원 큰엄마 허리 수술.md
          - 1.🎯(Project) 프로젝트/🧺 챙길 일/은행에 법인카드 발급 서류 물어보고 신청하기.md
  - type: kanban-view
    name: 👤 Rin
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🧺 챙길 일")
        - note["담당"].contains("[[Rin]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🧺 챙길 일
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 민규 서
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🧺 챙길 일")
        - note["담당"].contains("[[민규 서]]")
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🧺 챙길 일
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: kanban-view
    name: 👤 미할당
    filters:
      and:
        - file.inFolder("1.🎯(Project) 프로젝트/🧺 챙길 일")
        - note["담당"].isEmpty()
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
    quickAddFolder: 1.🎯(Project) 프로젝트/🧺 챙길 일
    groupByProperty: note.상태
    imageProperty: note.커버
    imageFit: cover
    imageAspectRatio: 0.667
    columnOrders:
      note.상태:
        - to do
        - 진행중
        - 확인 필요
        - 완료
        - 퍼즈
        - 히스토리
    columnColors:
      note.상태: {}
  - type: table
    name: 📊 전체 표
    order:
      - 담당
      - 일정
      - 마감
      - 작성자
newItemFolder: 1.🎯(Project) 프로젝트/🧺 챙길 일
newItemTemplate: 1.🎯(Project) 프로젝트/🧺 챙길 일/!(Template) 챙길 일.md
