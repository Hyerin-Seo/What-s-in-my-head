  "title": "통합 원심분리기 (v1-B 노션 스타일 호흡형)",
  "rootNodes": [
    {
      "id": "a2x3LGrlLaVO",
      "text": "📌 [Notion Callout] 거대하고 화려한 레퍼런스를 80% 공통 기본기와 20% 킬러 무기로 해체하여 우리 제품의 20% 독창성 포인트를 검증하는 작업대입니다.",
      "children": [],
      "isFolded": false,
      "nodeType": "quote",
      "createdAt": 1792392358442,
      "updatedAt": 1792392358442
    },
    {
      "id": "9NXasSTx5R73",
      "text": "",
      "children": [],
