                    },
                    {
                      "id": "RC6GrVPDXaIf",
                      "text": "데이터 본문 셀 슬롯 (Data Cell Slot)",
                      "children": [
                        {
                          "id": "wiuUcRPPxmvY",
                          "text": "데이터 텍스트 및 수치 입력",
