filters:
  and:
    - note["유형"] == "원칙"
views:
  - type: cards
    name: 🖼️ 갤러리
    order:
      - file
      - 요약
    sort:
      - property: 작성일
        direction: ASC
    image: 커버
    imageAspectRatio: 0.5
    imageFit: cover
    cardSize: 210
  - type: cards
    name: 🗂️ 분류별
    groupBy:
      property: 분류
      direction: ASC
    order:
      - file
      - 요약
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 190
  - type: table
    name: 📊 전체 표
    order:
      - file
      - 분류
      - 주제
      - 요약
      - 작성일
      - file.mtime
      - 담당
      - 작성자
    sort:
      - property: 작성일
        direction: ASC
    summaries:
      유형: Filled
