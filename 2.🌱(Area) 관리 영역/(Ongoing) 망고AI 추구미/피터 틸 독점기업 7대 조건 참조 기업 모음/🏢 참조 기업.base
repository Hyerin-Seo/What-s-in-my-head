filters:
  and:
    - note["유형"] == "기업"
views:
  - type: cards
    name: 🎴 카드
    order:
      - file
      - 주제
    sort:
      - property: file.name
        direction: ASC
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 200
  - type: cards
    name: 🏷️ 주제별
    groupBy:
      property: 주제
      direction: ASC
    order:
      - file
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 180
  - type: table
    name: 📊 전체 표
    order:
      - file
      - 주제
      - 작성일
      - 상위
    sort:
      - property: file.name
        direction: ASC
    summaries:
      유형: Filled
newItemFolder: "2.🌱(Area) 관리 영역/(Ongoing) 망고AI 추구미/피터 틸 독점기업 7대 조건 참조 기업 모음"
