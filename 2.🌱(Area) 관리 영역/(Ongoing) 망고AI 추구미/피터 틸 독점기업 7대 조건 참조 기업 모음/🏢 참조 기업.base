filters:
  and:
    - note["유형"] == "기업"
views:
  - type: cards
    name: 🎴 카드
    order:
      - 제목
      - 주제
    sort:
      - property: 제목
        direction: ASC
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 200
  - type: cards
    name: 🏷️ 주제별
    groupBy:
      property: 주제
      direction: ASC
    order:
      - 제목
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 180
  - type: table
    name: 📊 전체 표
    order:
      - file
      - 주제
      - 작성일
      - 상위
    sort:
      - property: 제목
        direction: ASC
    summaries:
      제목: Filled
