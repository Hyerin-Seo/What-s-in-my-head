filters:
  and:
    - file.ext == "md"
    - note["유형"] == "홈"
formulas:
  대문: if(note["구역"] == "0.inbox", "0. inbox", file.name)
views:
  - type: cards
    name: 🏠 홈 카드
    order:
      - formula.대문
      - 요약
    sort:
      - property: formula.대문
        direction: ASC
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 140
