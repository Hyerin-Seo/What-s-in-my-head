filters:
  and:
    - file.ext == "md"
    - note["유형"] == "바로가기"
    - note["구역"] != "4.archive"
views:
  - type: cards
    name: 🔖 바로가기
    order:
      - file
      - 요약
    sort:
      - property: 순서
        direction: ASC
    image: 커버
    imageAspectRatio: 0.667
    imageFit: cover
    cardSize: 185
