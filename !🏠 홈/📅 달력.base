filters:
  or:
    - and:
        - note["유형"] == "휴가"
        - not:
            - note["작성일"].isEmpty()
    - and:
        - note["유형"] == "할일"
        - not:
            - note["상태"] == "히스토리"
        - or:
            - not:
                - note["마감"].isEmpty()
            - not:
                - note["일정"].isEmpty()
formulas:
  달력시작: if(note["유형"] == "휴가", date(note["작성일"]), if(!note["일정"].isEmpty(), date(note["일정"]), if(!note["시작"].isEmpty(), date(note["시작"]), date(note["마감"]))))
  달력끝: if(note["유형"] == "휴가" || note["일정"].isEmpty(), if(!note["마감"].isEmpty(), date(note["마감"])))
  구분: if(note["유형"] == "휴가", "🏖️ 근무표", if(!note["일정"].isEmpty(), "📅 일정", if(!note["시작"].isEmpty(), "⏳ 기간", "⏰ 마감")))
  아이콘: if(note["유형"] == "휴가", "🏖️", if(!note["일정"].isEmpty(), "📅", if(!note["시작"].isEmpty(), "⏳", "⏰")))
views:
  - type: calendar
    name: 📅 이번 달
    order:
      - file
      - formula.아이콘
      - 담당
    startDate: formula.달력시작
    endDate: formula.달력끝
    weekStartDay: sunday
  - type: table
    name: 📋 날짜 순
    order:
      - file
      - formula.구분
      - 상태
      - formula.달력시작
      - formula.달력끝
      - 일정
      - 시작
      - 마감
      - 담당
    sort:
      - property: formula.달력시작
        direction: ASC
    summaries:
      유형: Filled
